@using Sandbox
@using Sandbox.UI
@using System.Linq
@namespace Sandbox.UI

@inherits Panel

<style>
    RequestHistory {
        width: 24%;
        height: 100%;
        flex-direction: column;
        background-color: #0f1013;
        border-left: 1px solid #ffffff12;
        font-family: Poppins;
        color: #e6e6e6;

        .hist-header {
            flex-shrink: 0;
            flex-direction: row;
            align-items: center;
            gap: 8px;
            padding: 0 14px;
            height: 50px;
            font-family: BerlinSansFBDemi;
            font-size: 18px;
            letter-spacing: 2px;
            color: #00d7bb;
            background-color: #16181b;
            border-bottom: 1px solid #ffffff12;
            i { font-size: 20px; }
            .hist-total {
                margin-left: auto;
                padding: 2px 9px;
                border-radius: 10px;
                font-family: Poppins;
                font-size: 12px;
                letter-spacing: 0px;
                background-color: #00d7bb22;
            }
        }

        .hist-tools {
            flex-shrink: 0;
            flex-direction: column;
            gap: 8px;
            padding: 10px 10px 6px 10px;
        }

        .hist-search {
            flex-direction: row;
            align-items: center;
            gap: 6px;
            height: 32px;
            padding: 0 10px;
            border-radius: 8px;
            background-color: #0b0c0e;
            border: 1px solid #ffffff1f;
            i { font-size: 16px; color: #ffffff55; }
            TextEntry {
                flex-grow: 1;
                height: 100%;
                align-items: center;
                font-size: 13px;
                color: #f0f0f0;
                background-color: transparent;
                .placeholder { color: #ffffff40; }
            }
        }

        .hist-sort {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 5px;
            .sort-btn {
                padding: 3px 10px;
                border-radius: 12px;
                font-size: 12px;
                color: #ffffff99;
                background-color: #ffffff0d;
                transition: all 0.1s ease;
                &:hover { color: white; background-color: #ffffff1a; cursor: pointer; }
                &.active { color: #0b0c0e; background-color: #00d7bb; }
            }
        }

        .hist-list {
            flex-grow: 1;
            flex-direction: column;
            overflow: scroll;
            gap: 6px;
            padding: 4px 10px 10px 10px;
        }

        .hist-item {
            flex-shrink: 0;
            flex-direction: row;
            align-items: center;
            gap: 10px;
            height: 64px;
            padding: 5px;
            border-radius: 10px;
            background-color: #ffffff08;
            border: 1px solid #ffffff0a;
            transition: all 0.12s ease;
            &:hover {
                background-color: #00d7bb14;
                border-color: #00d7bb40;
                .hist-actions { opacity: 1; }
            }
        }

        .hist-thumb {
            position: relative;
            flex-shrink: 0;
            width: 96px;
            height: 54px;
            border-radius: 6px;
            overflow: hidden;
            justify-content: flex-end;
            align-items: flex-end;
            background-color: #000000;
            &:hover { cursor: pointer; }
            .ph {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                justify-content: center;
                align-items: center;
                font-size: 26px;
                color: #ffffff55;
                background-color: #1b1d21;
                &.yt { color: #ff4e45aa; }
                &.tw { color: #a970ffaa; }
                &.sc { color: #ff7700aa; }
                &.dr { color: #00d7bbaa; }
            }
            .img {
                position: absolute;
                left: 0px;
                top: 0px;
                width: 100%;
                height: 100%;
                background-size: contain;
                background-repeat: no-repeat;
                background-position: center;
            }
            .badge {
                margin: 3px;
                padding: 0px 4px;
                border-radius: 3px;
                font-size: 10px;
                color: white;
                background-color: #000000cc;
                &.live { background-color: #e5303a; }
            }
        }

        .hist-info {
            flex-grow: 1;
            flex-shrink: 1;
            width: 0;
            flex-direction: column;
            justify-content: center;
            gap: 4px;
            overflow: hidden;
            &:hover { cursor: pointer; }
            .hist-title {
                font-family: BerlinSansFBDemi;
                font-size: 14px;
                color: white;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .hist-meta {
                flex-direction: row;
                align-items: center;
                gap: 6px;
                font-size: 11px;
                color: #ffffff80;
                white-space: nowrap;
                overflow: hidden;
                i { font-size: 13px; }
                .svc { flex-direction: row; align-items: center; gap: 3px; flex-shrink: 0; }
                .svc.yt { color: #ff4e45; }
                .svc.tw { color: #a970ff; }
                .svc.sc { color: #ff7700; }
                .svc.dr { color: #00d7bb; }
                .dot { color: #ffffff33; }
            }
        }

        .hist-actions {
            flex-shrink: 0;
            flex-direction: column;
            gap: 4px;
            opacity: 0.45;
            transition: opacity 0.12s ease;
            .btn-ha {
                width: 26px;
                height: 26px;
                border-radius: 6px;
                justify-content: center;
                align-items: center;
                font-size: 17px;
                transition: all 0.1s ease;
                &:hover { cursor: pointer; }
            }
            .btn-play { color: #0b0c0e; background-color: #00d7bb; &:hover { background-color: #3cf0d6; } }
            .btn-del { color: #ff6b6b; background-color: #ff6b6b1a; &:hover { background-color: #ff6b6b40; } }
        }

        .hist-empty {
            flex-grow: 1;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding-top: 20%;
            font-size: 13px;
            color: #ffffff40;
            i { font-size: 40px; }
        }

        .hist-pager {
            flex-shrink: 0;
            flex-direction: row;
            align-items: center;
            gap: 4px;
            height: 40px;
            padding: 0 8px;
            background-color: #16181b;
            border-top: 1px solid #ffffff12;
            .pg-btn {
                width: 26px;
                height: 26px;
                border-radius: 6px;
                justify-content: center;
                align-items: center;
                font-size: 20px;
                color: #00d7bb;
                &:hover { cursor: pointer; background-color: #00d7bb1f; }
                &.disabled { color: #ffffff30; pointer-events: none; }
            }
            .pg-info { flex-grow: 1; justify-content: center; font-size: 12px; color: #ffffff80; }
            .btn-clear {
                flex-direction: row;
                align-items: center;
                gap: 4px;
                padding: 3px 9px;
                border-radius: 6px;
                font-size: 12px;
                color: #ff6b6bcc;
                border: 1px solid #ff6b6b44;
                transition: all 0.12s ease;
                i { font-size: 14px; }
                &:hover { color: #ff6b6b; background-color: #ff6b6b1a; cursor: pointer; }
                &.confirm { color: white; background-color: #e5303a; border-color: #e5303a; }
            }
        }
    }
</style>

<root>
    <div class="hist-header">
        <i>history</i>
        <label>HISTORY</label>
        <label class="hist-total">@RequestHistoryStore.GetAll().Count</label>
    </div>

    <div class="hist-tools">
        <div class="hist-search">
            <i>search</i>
            <TextEntry @ref="SearchEntry" Placeholder="search..." />
        </div>
        <div class="hist-sort">
            <button class="sort-btn @(_sortMode=="lastRequest"?"active":"")" onclick=@(()=>SetSort("lastRequest"))>recent</button>
            <button class="sort-btn @(_sortMode=="title"?"active":"")"       onclick=@(()=>SetSort("title"))>A-Z</button>
            <button class="sort-btn @(_sortMode=="duration"?"active":"")"    onclick=@(()=>SetSort("duration"))>duration</button>
            <button class="sort-btn @(_sortMode=="count"?"active":"")"       onclick=@(()=>SetSort("count"))>popular</button>
        </div>
    </div>

    <div class="hist-list">
        @if ( !PageItems.Any() )
        {
            <div class="hist-empty">
                <i>movie_filter</i>
                <label>@(string.IsNullOrEmpty(_lastSearch) ? "no history yet" : "nothing found")</label>
            </div>
        }
        else
        {
            foreach ( var entry in PageItems )
            {
                var svc = ServiceOf( entry.Url );
                <div class="hist-item">
                    <div class="hist-thumb" onclick=@(() => OnItemClick( entry ))>
                        <div class="ph @svc.Css"><i>@svc.Icon</i></div>
                        @if ( !string.IsNullOrEmpty( entry.Thumb ) )
                        {
                            <div class="img" style="background-image: url(@entry.Thumb)"></div>
                        }
                        <label class="badge @(entry.Duration > 0 ? "" : "live")">@(entry.Duration > 0 ? FormatTime(entry.Duration) : "LIVE")</label>
                    </div>

                    <div class="hist-info" onclick=@(() => OnItemClick( entry ))>
                        <label class="hist-title">@entry.Title</label>
                        <div class="hist-meta">
                            <div class="svc @svc.Css"><i>@svc.Icon</i><label>@svc.Name</label></div>
                            <label class="dot">•</label>
                            <label>@TimeAgo( entry.LastRequest )</label>
                            @if ( entry.Count > 1 )
                            {
                                <label class="dot">•</label>
                                <label>x@(entry.Count)</label>
                            }
                        </div>
                    </div>

                    <div class="hist-actions">
                        <button class="btn-ha btn-play" onclick=@(() => OnRequestClick( entry ))><i>play_arrow</i></button>
                        <button class="btn-ha btn-del"  onclick=@(() => OnDeleteClick( entry ))><i>delete</i></button>
                    </div>
                </div>
            }
        }
    </div>

    <div class="hist-pager">
        <button class="pg-btn @(CurrentPage<=1?"disabled":"")" onclick=@PrevPage><i>chevron_left</i></button>
        <label class="pg-info">@CurrentPage / @TotalPages</label>
        <button class="pg-btn @(CurrentPage>=TotalPages?"disabled":"")" onclick=@NextPage><i>chevron_right</i></button>
        <button class="btn-clear @(_confirmClear?"confirm":"")" onclick=@OnClearAll><i>delete_sweep</i><label>@(_confirmClear ? "sure?" : "clear all")</label></button>
    </div>
</root>

@code {
    public RequestMenu RequestMenu { get; set; }

    private TextEntry SearchEntry { get; set; }

    private const int PageSize = 50;
    private List<HistoryEntry> _filtered = new();
    private string _sortMode = "lastRequest";
    private string _lastSearch = "";
    private bool _confirmClear;
    private RealTimeSince _sinceConfirm;
    private int CurrentPage { get; set; } = 1;
    private int TotalPages => Math.Max( 1, (int)Math.Ceiling( _filtered.Count / (double)PageSize ) );
    private IEnumerable<HistoryEntry> PageItems => _filtered.Skip( (CurrentPage - 1) * PageSize ).Take( PageSize );

    private record struct ServiceInfo( string Name, string Icon, string Css );

    protected override void OnAfterTreeRender( bool firstTime )
    {
        base.OnAfterTreeRender( firstTime );
        if ( !firstTime ) return;
        Refresh();
    }

    public void RecordAndRefresh( string url, string title, string thumb, float duration )
    {
        RequestHistoryStore.Record( url, title, thumb, duration );
        Refresh();
    }

    public void Refresh()
    {
        ApplyFilters();
        StateHasChanged();
    }

    private void SetSort( string mode )
    {
        _sortMode = mode;
        CurrentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    private void PrevPage() { if ( CurrentPage > 1 ) { CurrentPage--; StateHasChanged(); } }
    private void NextPage() { if ( CurrentPage < TotalPages ) { CurrentPage++; StateHasChanged(); } }

    private void OnItemClick( HistoryEntry e ) => RequestMenu?.SetHistoryUrl( e.Url );
    private void OnRequestClick( HistoryEntry e ) => RequestMenu?.RunURL( e.Url );

    private void OnDeleteClick( HistoryEntry e )
    {
        RequestHistoryStore.RemoveById( e.Id );
        _filtered.RemoveAll( x => x.Id == e.Id );
        StateHasChanged();
    }

    /// <summary>First click asks, the second one within a few seconds clears.</summary>
    private void OnClearAll()
    {
        if ( !_confirmClear )
        {
            _confirmClear = true;
            _sinceConfirm = 0;
            StateHasChanged();
            return;
        }
        _confirmClear = false;
        RequestHistoryStore.ClearAll();
        _filtered.Clear();
        CurrentPage = 1;
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        var q = _lastSearch.ToLowerInvariant();
        var all = RequestHistoryStore.GetAll();

        IEnumerable<HistoryEntry> res = string.IsNullOrEmpty( q )
            ? all
            : all.Where( e => e.Title.ToLowerInvariant().Contains( q ) || e.Url.ToLowerInvariant().Contains( q ) );

        _filtered = _sortMode switch
        {
            "title"    => res.OrderBy( e => e.Title ).ToList(),
            "duration" => res.OrderByDescending( e => e.Duration ).ToList(),
            "count"    => res.OrderByDescending( e => e.Count ).ToList(),
            _          => res.OrderByDescending( e => e.LastRequest ).ToList()
        };
    }

    private static ServiceInfo ServiceOf( string url )
    {
        var u = url?.ToLowerInvariant() ?? "";
        if ( u.Contains( "youtube.com" ) || u.Contains( "youtu.be" ) ) return new( "YouTube", "smart_display", "yt" );
        if ( u.Contains( "twitch.tv" ) ) return new( "Twitch", "live_tv", "tw" );
        if ( u.Contains( "soundcloud.com" ) ) return new( "SoundCloud", "graphic_eq", "sc" );
        return new( "Direct", "link", "dr" );
    }

    private static string TimeAgo( long unix )
    {
        var ago = DateTimeOffset.UtcNow - DateTimeOffset.FromUnixTimeSeconds( unix );
        if ( ago.TotalMinutes < 1 ) return "just now";
        if ( ago.TotalHours < 1 ) return $"{(int)ago.TotalMinutes} min ago";
        if ( ago.TotalDays < 1 ) return $"{(int)ago.TotalHours} h ago";
        if ( ago.TotalDays < 30 ) return $"{(int)ago.TotalDays} d ago";
        return DateTimeOffset.FromUnixTimeSeconds( unix ).ToLocalTime().ToString( "dd.MM.yyyy" );
    }

    private static string FormatTime( float seconds )
    {
        var t = TimeSpan.FromSeconds( seconds );
        return t.Hours > 0
            ? $"{t.Hours}:{t.Minutes:D2}:{t.Seconds:D2}"
            : $"{t.Minutes}:{t.Seconds:D2}";
    }

    protected override int BuildHash()
    {
        var cur = SearchEntry?.Value ?? "";
        if ( cur != _lastSearch )
        {
            _lastSearch = cur;
            CurrentPage = 1;
            ApplyFilters();
        }
        if ( _confirmClear && _sinceConfirm > 3 ) _confirmClear = false;

        var first = _filtered.FirstOrDefault();
        return HashCode.Combine( CurrentPage, _sortMode, _filtered.Count, _lastSearch, first?.Id ?? "", first?.Title ?? "", _confirmClear );
    }
}
