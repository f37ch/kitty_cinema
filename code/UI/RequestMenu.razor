@using Sandbox
@using System
@using Sandbox.UI
@using System.Linq
@using System.Threading.Tasks
@using System.Web
@namespace Sandbox.UI

@inherits PanelComponent

<style>
    @@keyframes requestmenu-in {
        0% { opacity: 0; transform: scale(0.94); }
        100% { opacity: 1; transform: scale(1); }
    }

    RequestMenu {
        position: absolute;
        width: 85%;
        height: 78%;
        left: 7.5%;
        top: 8%;
        flex-direction: row;
        background-color: #0d0e10f5;
        border: 1px solid #ffffff1a;
        border-radius: 12px;
        box-shadow: 0px 12px 48px #000000cc;
        overflow: hidden;
        font-family: BerlinSansFBDemi;
        color: #e6e6e6;
        pointer-events: all;
        animation: requestmenu-in 0.2s ease-out;
        transition: all 0.15s ease-in;

        &.Direct {
            width: 50%;
            height: auto;
            left: 25%;
            top: 40%;
        }

        &.Closing {
            opacity: 0;
            transform: scale(0.94);
            pointer-events: none;
        }
    }

    .browser-wrap {
        flex-grow: 1;
        flex-shrink: 1;
        width: 0;
        flex-direction: column;
    }

    .rm-header {
        flex-shrink: 0;
        flex-direction: row;
        align-items: center;
        height: 2.6vw;
        padding: 0.4vw;
        gap: 0.35vw;
        background-color: #16181b;
        border-bottom: 1px solid #ffffff12;
    }

    .rm-title {
        flex-shrink: 0;
        flex-direction: row;
        align-items: center;
        gap: 0.3vw;
        padding: 0 0.4vw;
        font-size: 0.85vw;
        color: #00d7bb;
        letter-spacing: 1px;
        i { font-size: 1.1vw; }
    }

    .rm-icon {
        flex-shrink: 0;
        width: 1.8vw;
        height: 100%;
        justify-content: center;
        align-items: center;
        border-radius: 6px;
        color: #cfcfcf;
        font-size: 1.15vw;
        transition: all 0.1s ease;
        &:hover { background-color: #ffffff14; color: white; cursor: pointer; }
        &.disabled { opacity: 0.25; pointer-events: none; }
        &.close:hover { background-color: #ff4d5e33; color: #ff6b6b; }
    }

    .rm-url {
        flex-grow: 1;
        flex-shrink: 1;
        height: 100%;
        flex-direction: row;
        align-items: center;
        padding: 0 0.3vw 0 0.5vw;
        gap: 0.35vw;
        background-color: #0b0c0e;
        border: 1px solid #ffffff1f;
        border-radius: 8px;
        transition: border-color 0.15s ease;
        &:hover { border-color: #ffffff38; }
        &.valid { border-color: #00d7bb66; }

        .rm-service {
            flex-shrink: 0;
            font-size: 1.05vw;
            color: #ffffff55;
            &.yt { color: #ff4e45; }
            &.tw, &.twl { color: #a970ff; }
            &.sc { color: #ff7700; }
            &.dr { color: #00d7bb; }
        }

        TextEntry {
            flex-grow: 1;
            flex-shrink: 1;
            height: 100%;
            align-items: center;
            font-family: Poppins;
            font-size: 0.8vw;
            color: #f0f0f0;
            background-color: transparent;
            white-space: nowrap;
            overflow: hidden;
            .placeholder { color: #ffffff40; }
        }

        .rm-chip {
            flex-shrink: 0;
            padding: 0.1vw 0.45vw;
            border-radius: 5px;
            font-size: 0.62vw;
            color: #00d7bb;
            background-color: #00d7bb1f;
            &.muted { color: #ffffff66; background-color: #ffffff0f; }
        }
    }

    .rm-request {
        flex-shrink: 0;
        height: 100%;
        flex-direction: row;
        align-items: center;
        gap: 0.3vw;
        padding: 0 0.8vw;
        border-radius: 8px;
        font-size: 0.85vw;
        color: #0b0c0e;
        background-color: #00d7bb;
        transition: all 0.12s ease;
        i { font-size: 1.05vw; }
        &:hover { background-color: #3cf0d6; cursor: pointer; }
        &.disabled { background-color: #2a2d31; color: #ffffff55; pointer-events: none; }
        &.busy { background-color: #00d7bb88; pointer-events: none; }
    }

    .rm-status {
        flex-shrink: 0;
        flex-direction: row;
        align-items: center;
        gap: 0.35vw;
        padding: 0.35vw 0.7vw;
        font-family: Poppins;
        font-size: 0.68vw;
        color: #ffffff80;
        background-color: #121417;
        border-bottom: 1px solid #ffffff0d;
        i { font-size: 0.9vw; }
        &.error { color: #ff8a8a; background-color: #3a1418; }
    }

    .rm-browser {
        flex-grow: 1;
        width: 100%;
        background-color: #0b0c0e;
    }

    RequestHistory {
        border-left: 1px solid #ffffff12;
    }
</style>

<root class="@(Direct?"Direct":"")">
    <div class="browser-wrap">
        <div class="rm-header">
            @if (Direct)
            {
                <div class="rm-title"><i>link</i><label>#requestmenu.direct</label></div>
            }
            else
            {
                <button class="rm-icon @(CanGoBack?"":"disabled")" @onclick=@(()=>Navigate(true))><i>arrow_back</i></button>
                <button class="rm-icon @(CanGoForward?"":"disabled")" @onclick=@(()=>Navigate(false))><i>arrow_forward</i></button>
                <button class="rm-icon" @onclick=@Reload><i>refresh</i></button>
            }
            <div class="rm-url @(Link!=null?"valid":"")">
                <i class="rm-service @(Link?.Type)">@(Link?.Icon??"public")</i>
                <TextEntry @ref="UrlEntry" Placeholder=@(Direct?"#requestmenu.placeholderDirect":"#requestmenu.placeholder") onsubmit=@Submit></TextEntry>
                @if (Link!=null)
                {
                    <label class="rm-chip">@Link.Name</label>
                }
                else if (!Direct)
                {
                    <label class="rm-chip muted">#requestmenu.browse</label>
                }
            </div>
            @if (!SteamShowcase)
            {
                <button class="rm-request @(Link==null?"disabled":"") @(Busy?"busy":"")" @onclick=@(()=>RunURL(UrlEntry.Value))>
                    <i>@(Busy?"hourglass_top":"playlist_add")</i>
                    <label>#requestmenu.request</label>
                </button>
            }
            <button class="rm-icon close" @onclick=@Close><i>close</i></button>
        </div>
        @if (Error!=null)
        {
            <div class="rm-status error"><i>error_outline</i><label>@Error</label></div>
        }
        else if (Direct)
        {
            <div class="rm-status"><i>info_outline</i><label>#requestmenu.directHint</label></div>
        }
        @if (!Direct)
        {
            <WebPanel class="rm-browser" @ref="WebPanel"></WebPanel>
        }
    </div>
</root>

@code{
    private class LinkInfo
    {
        public string Id;
        public string Type;
        public string Name;
        public string Icon;
    }

    private static readonly string[] TwitchReserved={"directory","videos","settings","search","downloads","p","jobs","login","signup","subscriptions","inventory","wallet","drops","turbo","prime"};

    private TextEntry UrlEntry {get;set;}
    private Chat Chat {get;set;}
    private WebPanel WebPanel {get;set;}
    private RequestHistory HistoryPanel {get;set;}
    public MediaPlayer MediaPlayer {get;set;}
    public bool SteamShowcase {get;set;}
    /// <summary>Only the link bar, no browser: "direct" start URL.</summary>
    public bool Direct {get;set;}
    public string CurURL {get;set;}
    private LinkInfo Link {get;set;}
    private string Error {get;set;}
    private bool Busy {get;set;}
    private bool Closing {get;set;}
    private string LastText {get;set;}
    private string LastSurfaceUrl {get;set;}
    private bool HistoryNavigation {get;set;}
    private RealTimeSince SinceError {get;set;}
    private int HistoryIndex {get;set;}=-1;
    private List<string> URList = new List<string>();
    private bool CanGoBack=>HistoryIndex>0;
    private bool CanGoForward=>HistoryIndex<URList.Count-1;

    public static RequestMenu Open(MediaPlayer mediaPlayer,string url)
    {
        if (mediaPlayer.PanelComponent.Components.TryGet<RequestMenu>(out var existing)) return existing;
        mediaPlayer.WorldInput.Enabled=false;
        var menu=mediaPlayer.PanelComponent.Components.Create<RequestMenu>();
        menu.MediaPlayer=mediaPlayer;
        menu.Direct=url=="direct";
        menu.CurURL=menu.Direct?null:url;
        return menu;
    }

    /// <summary>Puts a URL from the history into the link bar without requesting it.</summary>
    public void SetHistoryUrl(string url)
    {
        UrlEntry.Value=url;
        if (WebPanel!=null) WebPanel.Surface.Url=url;
    }
    public void RunURL(string url)
	{
        if (Busy||Closing) return;
        var link=ParseLink(url,out var error);
        if (link==null){
            ShowError(error??"This doesn't look like a link.");
            return;
        }
        if (MediaPlayer.RequestCD>Time.Now){
            ShowError("Wait a few seconds before requesting another video.");
            return;
        }
        MediaPlayer.RequestCD=Time.Now+2;
        _=ProcessData(link,url.Trim());
	}
    private void Submit()
    {
        var text=UrlEntry.Value?.Trim();
        if (string.IsNullOrEmpty(text)) return;
        // Enter browses like an address bar; the direct bar has nothing to browse.
        if (Direct||WebPanel==null){
            RunURL(text);
        }else{
            WebPanel.Surface.Url=text.Contains("://")?text:$"https://{text}";
        }
    }
    public void Navigate(bool back)
	{
        if (WebPanel==null) return;
        if (back?!CanGoBack:!CanGoForward) return;
        HistoryIndex+=back?-1:1;
        HistoryNavigation=true;
        WebPanel.Surface.Url=URList[HistoryIndex];
	}
    private void Reload()
    {
        if (WebPanel==null||HistoryIndex<0) return;
        HistoryNavigation=true;
        WebPanel.Surface.Url=URList[HistoryIndex];
    }

    protected override void OnStart(){
        Flags=ComponentFlags.NotNetworked;
        base.OnStart();
    }
    protected override void OnTreeFirstBuilt()
    {
        base.OnTreeFirstBuilt();
        if (!Direct&&WebPanel!=null){
            WebPanel.Style.PointerEvents=PointerEvents.All;
            WebPanel.Surface.InBackgroundMode=false;
            WebPanel.Surface.Url=CurURL;
            UrlEntry.Value=CurURL;
            HistoryPanel=Panel.AddChild<RequestHistory>();
            HistoryPanel.RequestMenu=this;
            HistoryPanel.Refresh();
        }
        UrlEntry.AcceptsFocus=true;
        if (Direct) UrlEntry.Focus();
        if (Game.ActiveScene.Components.TryGet<Chat>(out var chatty,FindMode.EnabledInSelfAndDescendants)){
            Chat=chatty;
        }
    }
    protected override void OnUpdate(){
        base.OnUpdate();
        if (Input.EscapePressed){
            Input.EscapePressed=false;
            Close();
            return;
        }
        if (WebPanel!=null){
            var url=WebPanel.Surface.Url;
            if (!string.IsNullOrEmpty(url)&&url!=LastSurfaceUrl){
                LastSurfaceUrl=url;
                if (HistoryNavigation){
                    HistoryNavigation=false;
                }else{
                    if (HistoryIndex<URList.Count-1) URList.RemoveRange(HistoryIndex+1,URList.Count-HistoryIndex-1);
                    URList.Add(url);
                    HistoryIndex=URList.Count-1;
                }
                // Follow the browser unless the player is typing.
                if (!UrlEntry.HasFocus) UrlEntry.Value=url;
            }
        }
        if (UrlEntry!=null&&UrlEntry.Value!=LastText){
            LastText=UrlEntry.Value;
            Link=ParseLink(LastText,out _);
            Error=null;
        }
        if (Error!=null&&SinceError>6) Error=null;
    }
    public void Close()
	{
        if (Closing) return;
        Closing=true;
        if (!SteamShowcase&&MediaPlayer.IsValid()){
            MediaPlayer.WorldInput.Enabled=true;
        }
        UrlEntry.AcceptsFocus=false;
        if (WebPanel!=null){
            WebPanel.Style.PointerEvents=PointerEvents.None;
        }
        AddClass("Closing");
        _=DestroyAfterAnimation();
	}
    private async Task DestroyAfterAnimation()
    {
        await Task.DelayRealtimeSeconds(0.15f);
        if (this.IsValid()) Destroy();
    }
    protected override void OnDestroy()
    {
        if (!Closing&&!SteamShowcase&&MediaPlayer.IsValid()&&MediaPlayer.WorldInput.IsValid()){
            MediaPlayer.WorldInput.Enabled=true;
        }
        HistoryPanel?.Delete();
        Panel?.Delete();
        base.OnDestroy();
    }
    private void ShowError(string message)
    {
        Error=message;
        SinceError=0;
    }
    private async Task ProcessData(LinkInfo link,string originalUrl){
        Busy=true;
        Error=null;
        try{
            var data=await Http.RequestJsonAsync<ParsedData>($"{MediaController.WebHandlersURL}parser.php?tp={link.Type}&id={Uri.EscapeDataString(link.Id)}","GET");
            if (data.title!=null){
                MediaController.BroadcastVideo(data,link.Id,link.Name,link.Type,MediaPlayer.GameObject.Id);
                RequestHistoryStore.Record(originalUrl,data.title??"Unknown",data.thumb??"/ui/thumb.png",data.duration);
                Busy=false;
                Close();
                return;
            }
            Fail($"Couldn't get video info{(string.IsNullOrEmpty(data.error)?".":$": {data.error}")}");
        }catch(Exception e){
            Fail($"Couldn't load this link ({e.Message}).");
		}
        Busy=false;
        HistoryPanel?.Refresh();
    }
    private void Fail(string message)
    {
        if (Closing||!this.IsValid()){
            Chat?.AddLocalText($"Failed to request video: {message}","video_settings");
        }else{
            ShowError(message);
        }
    }

    /// <summary>Recognizes a requestable link: a video, stream or track, not a site's home or search page.</summary>
    private static LinkInfo ParseLink(string url,out string error)
    {
        error=null;
        if (string.IsNullOrWhiteSpace(url)) return null;
        url=url.Trim();
        if (!url.Contains("://")) url=$"https://{url}";
        if (!Uri.TryCreate(url,UriKind.Absolute,out var uri)||(uri.Scheme!="http"&&uri.Scheme!="https")||!uri.Host.Contains('.')){
            error="This doesn't look like a link.";
            return null;
        }
        var host=uri.Host.ToLowerInvariant();
        if (host.StartsWith("www.")) host=host[4..];
        if (host.StartsWith("m.")) host=host[2..];
        var segs=uri.AbsolutePath.Split('/',StringSplitOptions.RemoveEmptyEntries);

        if (host=="youtube.com"||host=="music.youtube.com"||host=="youtu.be"){
            string id=null;
            if (host=="youtu.be"){
                id=segs.FirstOrDefault();
            }else{
                id=HttpUtility.ParseQueryString(uri.Query)["v"];
                if (string.IsNullOrEmpty(id)&&segs.Length>=2&&(segs[0]=="shorts"||segs[0]=="live"||segs[0]=="embed"||segs[0]=="v")) id=segs[1];
            }
            if (string.IsNullOrEmpty(id)){
                error="Open a YouTube video to request it.";
                return null;
            }
            return new LinkInfo{Id=id,Type="yt",Name="YouTube",Icon="smart_display"};
        }
        if (host=="twitch.tv"){
            if (segs.Length>=2&&segs[0]=="videos") return new LinkInfo{Id=segs[1],Type="tw",Name="Twitch VOD",Icon="live_tv"};
            if (segs.Length==1&&!TwitchReserved.Contains(segs[0].ToLowerInvariant())) return new LinkInfo{Id=segs[0],Type="twl",Name="Twitch Live",Icon="live_tv"};
            error="Open a Twitch channel or video to request it.";
            return null;
        }
        if (host=="soundcloud.com"){
            if (segs.Length==2&&segs[1]!="sets"&&segs[1]!="tracks"&&segs[1]!="likes"){
                return new LinkInfo{Id=$"https://soundcloud.com/{segs[0]}/{segs[1]}",Type="sc",Name="SoundCloud",Icon="graphic_eq"};
            }
            error="Open a SoundCloud track to request it.";
            return null;
        }
        return new LinkInfo{Id=url,Type="dr",Name="Direct link",Icon="link"};
    }

    protected override int BuildHash()
    {
        return HashCode.Combine(Link?.Type,Link?.Id,Error,Busy,HistoryIndex,URList.Count,Direct);
    }
}
