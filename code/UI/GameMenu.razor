@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using Sandbox.Network
@using Sandbox.UI
@using Sandbox.Audio
@inherits PanelComponent
<style>
GameMenu {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: radial-gradient(#333 0%, #161616 100%);
    background-size: 100% 100%;
    justify-content: flex-start;
    font-weight: bold;
    font-size: 62px;
    pointer-events: all;
    flex-direction: column;
    transition: all .15s ease-in-out;
    pointer-events: all;

    .logo {
        flex-direction: row;
        height: 35%;
        min-height: 35%;
        margin: 1%;
        transform: scale(1);
 
        .img {
            background-position: left;
            background-size: 100%;
            background-repeat: no-repeat;
            width: 310px;//18%
            flex-shrink: 0;
       
        }

        .img2 {
            width: 100%;
            background-position: left;
            background-size: contain;
            background-repeat: repeat;
        }
    }

    .main {
        flex-direction: row;
        margin: 1%;
        position: relative;
    
        .option_list {
            flex-direction: column;
            justify-content: flex-start;
            align-items: flex-start;
            //margin-top: auto;
            margin-bottom: auto;
            margin-right: 5%;
            width: 40%;
            gap: 14px;
            flex-shrink: 0;

            .button {
                transform: scale(1);
                background-color: rgb(59, 59, 59);
                font-weight: bolder;
                justify-content: flex-start;
                width: 100%;
                color: white;
                padding: 14px;
                border-radius: 14px;
                // Grow with wrapped text instead of being squeezed under the next button.
                flex-shrink: 0;
                transition: all 0.14s ease;

                &:hover {
                    sound-in: ui.button.over;
                    color: rgb(114, 201, 189);
                    transform: translateX(6%);
                }

                &:active {
                    sound-in: ui.button.press;
                }

                &.selected {
                    background-color: rgb(45, 97, 86);
                }
            }
        }

        .optionwind {
            border-radius: 14px;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 44px;
            margin-top: auto;
            margin-bottom: auto;
            transition: all .35s ease-in-out;
            margin-left: auto;
            margin-right: auto;
            width:50%;
            background-color: rgb(45, 97, 86);
            &.plain { background-color: transparent; }
            transform: scale(1);
            gap:14px;

            .st-scroll {
                width: 100%;
                max-height: 560px;
                flex-direction: column;
                gap: 8px;
                padding: 8px;
                border-radius: 14px;
                background-color: #0d0e10;
                overflow: scroll;
                font-family: Poppins;
                font-weight: normal;
            }
            .st-section {
                flex-shrink: 0;
                flex-direction: column;
                border-radius: 14px;
                background-color: #16181bf2;
                border: 1px solid #ffffff14;
                overflow: hidden;
            }
            .st-head {
                flex-direction: row;
                align-items: center;
                gap: 12px;
                padding: 6px 20px;
                font-family: BerlinSansFBDemi;
                font-size: 24px;
                letter-spacing: 1px;
                color: #00d7bb;
                background-color: #00d7bb14;
                border-bottom: 1px solid #ffffff0f;
                i { font-size: 30px; }
            }
            .st-row {
                flex-direction: row;
                align-items: center;
                gap: 16px;
                min-height: 44px;
                padding: 2px 20px;
                border-bottom: 1px solid #ffffff0a;
                transition: background-color 0.12s ease;
                &:hover { background-color: #ffffff08; }
            }
            .st-name {
                flex-grow: 1;
                flex-direction: row;
                align-items: center;
                gap: 12px;
                font-size: 22px;
                color: #e6e6e6;
                i { font-size: 26px; color: #ffffff66; }
            }
            .st-row .cinemaslider {
                flex-grow: 0;
                flex-shrink: 0;
                width: 320px;
                min-width: 320px;
                margin-top: 0px;
                > .inner > .track {
                    height: 8px;
                    background-color: #ffffff1f;
                    > .track-active { background-color: #00d7bb; }
                    > .thumb { width: 20px; height: 20px; }
                }
            }
            .st-val {
                flex-shrink: 0;
                width: 70px;
                justify-content: flex-end;
                font-size: 20px;
                color: #00d7bb;
            }
            .st-btn {
                flex-shrink: 0;
                width: 48px;
                height: 40px;
                justify-content: center;
                align-items: center;
                border-radius: 8px;
                font-size: 24px;
                color: #0b0c0e;
                background-color: #00d7bb;
                transition: background-color 0.12s ease;
                &:hover { background-color: #3cf0d6; cursor: pointer; sound-in: ui.button.over; }
                &:active { sound-in: ui.button.press; }
            }

            .info_container{
                transition: opacity .2s ease;
                position: absolute;
                top:80%;
                transform: scale(1);
                transition: all 0.14s ease;
               
                .text{
                
                    align-items: center;
                    gap:8px;
                    font-size: 54px;
                    transition: all 15s ease-in-out;
                    background-color: rgb(138, 67, 67);
                    font-weight: bolder;
                    color:white;
                    padding: 5px 10px;
                    border-radius: 14px;
                    .ic{
                        
                        border-radius: 18px;
                       background-color: rgba(75, 167, 129, 0.664); 
                       //border-radius: 100%;
                     
                    }
                }
            }

            .button-list {
                border-radius: 14px;
                flex-direction: column;
                overflow: scroll;
                width: 100%;
                gap:4px;
                max-height: 90%;

                .button {
                    background-color: transparent;
                    align-items: center;
                    color: #ffffff;
                    padding: 10px;
                    justify-content: space-between;
                    cursor: pointer;
                    width: 100%;
                    flex-direction: row;
                    flex-shrink: 0;
                    background-color: rgb(59, 59, 59);
                    position: relative; 

                    .text-wrapper {
                        flex-direction: column;
                        align-items: flex-start;
                    }

                    .title {
                        font-weight: bold;
                        font-size: 20px;
                    }

                    .map {
                        font-size: 16px;
                    }

                    .count {
                        margin-right: 1%;
                        font-size: 20px;
                        white-space: nowrap;
                    }

                    &:hover {
                        background-color: #333;
                    }
                }
            }

            .refresh_button {
                align-items: center;
                border-radius: 14px;
                font-size: 24px;
                background-color: rgb(59, 59, 59);
                justify-content: center;
                font-weight: bolder;
                color: white;
                margin-top: 1%;
                padding: 8px;
                width: 100%;
                cursor: pointer;

                &:hover {
                    sound-in: ui.button.over;
                    color: rgb(114, 201, 189);
                }

                .ic {
                    font-size: 30px;
                    background-color: rgba(80, 150, 114, 0.418);
                    border-radius: 100%;
                }

                &:active {
                    sound-in: ui.button.press;
                }
            }
            .stitle{
                background-color: rgb(7, 75, 69);
                border-radius: 14px;
                width: 100%;
                align-items: center;
                justify-content: center;
                margin:-4px;
            }
            .settings_list {
                flex-direction: column;
                width: 100%;
                gap:4px;
                overflow: scroll;
                max-height: 28%;
              

                

                .setting {
                    flex-shrink: 0;
                    align-items: center;
                    font-family: BerlinSansFBDemi;
                    padding: 10px;
                    width: 100%;
                    background-color: rgba(128, 128, 128, 0.418);
                    border-radius: 14px;
                    font-size: 34px;

                    .stext {
                        width: 100%;
                        justify-content: flex-end;
                    }

                    .cinemaslider {
                        width: 20%;
                        margin-top: 10px;
                    }
                    
                    .te{
                        width: 100%;
		                flex-shrink: 0;
                        background-color: #5a5a5a;
                    }
		            
                }
            }
        }

        
    }

    &.hide {
        opacity: 0;
        .logo {
            
            transition: all .35s ease-in-out;
            transform: scale(0);

        }
        .main {
            transition: all .15s ease-in-out;
            transform: scale(0);
        }
    }
    &.hideoption {
        .main {
            .optionwind {
                opacity: 0;
                transition: all .15s ease-in-out;
                transform: scale(0);
            }
        }
    }
    .setting_justify{
        min-height: 60px;
        justify-content: space-around;
        padding: 10px;
        width: 100%;
        background-color: rgba(128, 128, 128, 0.418);
        border-radius: 14px;
        font-size: 44px;
    }
    .stbutton{
        height: 40px;
        padding-left: 40px;
        padding-right: 40px;
        font-size:1.2vw;
        border-radius: 8px;
        background-color: rgba(34, 102, 74, 0.664); 
        align-items: center;
        &:hover {
            background-color: rgba(53, 153, 111, 0.664);
            cursor:pointer;
        }
        &:active {
            sound-in: ui.button.press;
        }
    }
}
</style>
<root class="@(IsMenuOpen ? "" : "hide")">
    <div class="logo">
        <img class="img" src="/ui/logo.png"><img>
        <img class="img2" src="/ui/paws_pattern.png"><img>
    </div>
    <div class="main">
        <div class="option_list">
            <!--<div class="logo">
                <text style="color:rgb(0,215,187);">Kitty|</text><text style="color:white;">Cinema</text>
            </div>-->
            <div class="button" onclick=@(()=>Create())>#menu.newLobby</div>
            <div class="button @(@selectedB=="servers"?"selected":"")" onclick=@(()=>SelectOption("servers"))>#menu.serverList</div>
            <div class="button @(@selectedB=="settings"?"selected":"")" onclick=@(()=>SelectOption("settings"))>#menu.settings</div>
            <div class="button" onclick=@(()=>Quit())>#menu.quit</div>
        </div>
        <div class="optionwind @(selected=="settings"?"plain":"")">
            @if (selected=="servers"){
                @if (IsConnecting){
                    <div class="parseinfo">#menu.connecting</div>
                }
                else if(parsingServers)
	    		{
	    			<div class="parseinfo">#menu.parsing</div>
	    		}
	    		else if (ServerList.Count==0)
	    		{
	    			<div class="parseinfo">#menu.nosv</div>
	    		}
	    		else
	    		{
	    			<div class="button-list">
	    				@foreach (var sv in ServerList)
	    				{
                            @if (sv.IsHidden){continue;}
	    					<div class="button" onclick=@(()=>Preconnect(sv))>
                                <div class="text-wrapper"> <div class="title">
                                        @sv.Name
                                    </div>
                                    <div class="map">
                                        @sv.Map
                                    </div>
                                </div>
                                <div class="count">
                                    @sv.Members/@sv.MaxMembers
                                </div>
                            </div>
	    				}
	    			</div>
	    		}
                <div class="refresh_button" onclick=@(()=>RefreshServerList())><i class="ic">refresh</i>#menu.refreshsv</div>
            }else if (selected=="settings"){
                var st=Settings.Data;
                <div class="st-scroll">
                    <div class="st-section">
                        <div class="st-head"><i>tune</i><label>#menu.settings.main</label></div>
                        <div class="st-row">
                            <div class="st-name"><i>visibility</i><label>#menu.settings.fov</label></div>
                            <CinemaSlider class="cinemaslider st-slider" ShowValueTooltip=@(false) Min=@(50) Max=@(120) Step=@(1) Value=@st.PlayerFov OnValueChanged=@FovSet/>
                            <label class="st-val">@($"{(int)st.PlayerFov}°")</label>
                        </div>
                        <div class="st-row">
                            <div class="st-name"><i>keyboard</i><label>#menu.settings.binds</label></div>
                            <button class="st-btn" onclick=@(()=>Game.Overlay.ShowBinds())><i>open_in_new</i></button>
                        </div>
                    </div>

                    <div class="st-section">
                        <div class="st-head"><i>volume_up</i><label>#menu.settings.sound</label></div>
                        <div class="st-row">
                            <div class="st-name"><i>speaker</i><label>#menu.settings.overallVolume</label></div>
                            <CinemaSlider class="cinemaslider st-slider" ShowValueTooltip=@(false) Max=@(100) Step=@(1) Value=@(st.OverAllVolume*100) OnValueChanged=@OverVolSet/>
                            <label class="st-val">@Percent(st.OverAllVolume)</label>
                        </div>
                        <div class="st-row">
                            <div class="st-name"><i>mic</i><label>#menu.settings.voiceVolume</label></div>
                            <CinemaSlider class="cinemaslider st-slider" ShowValueTooltip=@(false) Max=@(100) Step=@(1) Value=@(st.VoiceVolume*100) OnValueChanged=@VoiceVolSet/>
                            <label class="st-val">@Percent(st.VoiceVolume)</label>
                        </div>
                        <div class="st-row">
                            <div class="st-name"><i>graphic_eq</i><label>#menu.settings.effectVolume</label></div>
                            <CinemaSlider class="cinemaslider st-slider" ShowValueTooltip=@(false) Max=@(100) Step=@(1) Value=@(st.SFXVolume*100) OnValueChanged=@SFXVolSet/>
                            <label class="st-val">@Percent(st.SFXVolume)</label>
                        </div>
                        <div class="st-row">
                            <div class="st-name"><i>web</i><label>#menu.settings.interfaceVolume</label></div>
                            <CinemaSlider class="cinemaslider st-slider" ShowValueTooltip=@(false) Max=@(100) Step=@(1) Value=@(st.InterfaceVolume*100) OnValueChanged=@UIVolSet/>
                            <label class="st-val">@Percent(st.InterfaceVolume)</label>
                        </div>
                        <div class="st-row">
                            <div class="st-name"><i>directions_walk</i><label>#menu.settings.footstepsVolume</label></div>
                            <CinemaSlider class="cinemaslider st-slider" ShowValueTooltip=@(false) Max=@(100) Step=@(1) Value=@(st.FootStepVolume*100) OnValueChanged=@FootstepSet/>
                            <label class="st-val">@Percent(st.FootStepVolume)</label>
                        </div>
                    </div>

                    <div class="st-section">
                        <div class="st-head"><i>groups</i><label>#menu.settings.lobby</label></div>
                        <div class="st-row">
                            <div class="st-name"><i>lock</i><label>#menu.settings.lobby.friends</label></div>
                            <CinemaSwitch class="cinemaswitch" Value=@IsLobbyPrivate OnValueChanged=@TogglePrivate/>
                        </div>
                    </div>
                </div>
            }else if (selected=="displaytext"){
                <div class="info_container">
                    <div class="text"><i class="ic">@DisplayIcon</i>@DisplayText</div>
                </div>
            }
        </div>
    </div>
</root>

@code{
    public bool IsMenuOpen {get;set;}
    private bool IsInitScene {get;set;}
    public TextEntry TextEntry {get;set;}
    public CameraComponent Camera {get;set;}
    public float FootStepsVolume {get;set;}
    public string selected {get;set;}="servers";
    public string selectedB {get;set;}="servers";
    public string DisplayText {get;set;}="HOST LEFT THE GAME";
    public string DisplayIcon {get;set;}="sensors_off";
    public bool IsConnecting {get;set;}
    public bool IsLobbyPrivate {get;set;}
    public bool IsLobbyNeedPassword {get;set;}
    public string LobbyPassword {get;set;}
    private bool parsingServers {get;set;}
	private List<LobbyInformation> ServerList {get;set;}=new();
    // Every change goes through Settings: it applies the value locally and saves it shortly after.
    private void FovSet(float val){
        Settings.Change(s=>s.PlayerFov=val);
        StateHasChanged();
    }
    private void FootstepSet(float val){
        Settings.Change(s=>s.FootStepVolume=val/100);
        StateHasChanged();
    }
    private void OverVolSet(float val){
        Settings.Change(s=>s.OverAllVolume=val/100);
        StateHasChanged();
    }
    private void VoiceVolSet(float val){
        Settings.Change(s=>s.VoiceVolume=val/100);
        StateHasChanged();
    }
    private void SFXVolSet(float val){
        Settings.Change(s=>s.SFXVolume=val/100);
        StateHasChanged();
    }
    private void UIVolSet(float val){
        Settings.Change(s=>s.InterfaceVolume=val/100);
        StateHasChanged();
    }
    private void TogglePrivate(bool val){
        IsLobbyPrivate=val;
        Settings.Change(s=>s.PrivateLobby=val);
        StateHasChanged();
    }
    private static string Percent(float v)=>$"{MathF.Round(v*100)}%";
    private void TogglePassword(bool val){
        IsLobbyNeedPassword=val;
    }
    protected override void OnUpdate(){
        base.OnUpdate();
        Settings.Tick();
        // The camera may be replaced or reset (scene load, network snapshot): keep the player's FOV on it.
        var cam=Scene.Camera;
        if (cam.IsValid()&&cam.FieldOfView!=Settings.Data.PlayerFov) cam.FieldOfView=Settings.Data.PlayerFov;

        if(!IsInitScene&&Input.EscapePressed&&!SprayMenu.IsOpen&&!TauntMenu.IsOpen&&!Chat.IsTyping){
            Input.EscapePressed = false;
            IsMenuOpen=!IsMenuOpen;
            if (!IsMenuOpen){
                Settings.Save();
            }else{
                if (selected=="servers"){
                    _=RefreshServerList();
                }
            }
        }
    }
    protected void Create()
	{
        Settings.Save();
        Networking.Disconnect();
        var theater_scene=ResourceLibrary.Get<SceneFile>("scenes/theater.scene");
		Game.ActiveScene.Load(theater_scene);
	}
    protected void Quit()
	{
        Settings.Save();
		Game.Close();
	}
    protected async Task SelectOption(string type)
	{
        AddClass("hideoption");
        if (type=="servers"){
            _=RefreshServerList();
        }
        selectedB=type;
        StateHasChanged();
        await Task.DelayRealtimeSeconds(.3f);
        selected=type;
        RemoveClass("hideoption");
        StateHasChanged();
    }
    protected override void OnStart()
	{
        // Searched once: the scene doesn't change under a running menu.
        IsInitScene=Game.ActiveScene.Components.Get<SceneInformation>(FindMode.EnabledInSelfAndDescendants)?.Title=="init";
        var isInit=IsInitScene;

   
        if (isInit){
            Settings.Load();
        }
        Camera=Scene.Camera;
        IsMenuOpen=isInit;
		_=RefreshServerList();
	}
    private async Task RefreshServerList()
	{
		parsingServers=true;
		StateHasChanged();
		ServerList=await Networking.QueryLobbies();
		parsingServers=false;
		StateHasChanged();
	}
    protected void Preconnect(LobbyInformation Server)
	{
        Settings.Save();
        if (Game.ActiveScene.Components.Get<SceneInformation>(FindMode.EnabledInSelfAndDescendants).Title!="init"){
            Networking.Disconnect();
            var init_scene=ResourceLibrary.Get<SceneFile>("scenes/init.scene");
		    Game.ActiveScene.Load(init_scene);
        }
        _=Game.ActiveScene.GetAllComponents<GameMenu>().FirstOrDefault().Connect(Server.LobbyId);
	}
	private async Task Connect(ulong LobbyId)
	{
        //GameNetworkSystem.Connect(LobbyId);
        Game.ActiveScene.GetAllComponents<GameMenu>().FirstOrDefault().IsConnecting=true;
        await Task.DelayRealtimeSeconds(.5f);
        Networking.Connect(LobbyId);
        //await Task.DelayRealtimeSeconds(5);
        Game.ActiveScene.GetAllComponents<GameMenu>().FirstOrDefault().IsConnecting=false;
	}
    protected override int BuildHash()=>HashCode.Combine(IsMenuOpen);
}