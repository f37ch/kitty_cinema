@using System
@using Sandbox
@using Sandbox.UI

@inherits Panel

<style>
    .ScreeenUI
    {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        font-family:BerlinSansFBDemi;
        text-align: center;
        color:white;
        align-items: center;
        
        background-image: radial-gradient(#333 0%,#161616 100%);
        background-size: 100% 100%;

        .logo {
            margin-top: 4vh;
            margin-bottom: 4vh;
            font-size: 7vw;
    	    font-weight: bolder;
        }
        .info{
            margin-top:auto;
            margin-bottom:2%;
            font-size: 4vw;
    	    font-weight: bolder;
        }
        .info.hover{
            font-size: 8vw; 
        }
        .container {
            position: relative;
            margin-top:2%;
            gap:4px;
            display: flex;
            flex-shrink:0;
            width: 90%;
            height: 35%;
            flex-direction: row;
            justify-content:center;
        }
        .service {
            position: relative;
            width: 100%;
            height:100%;
            margin-right: 1%;
            background-color: #EEE;
            border-radius: 8%;
            border: 6px solid transparent;
            overflow: hidden;
            transition: all 0.15s ease-out;
            .logo-img {
                width: 100%;
                height: 100%;
                background-size: contain;
                background-repeat: no-repeat;
                background-position: center center;
                transition: transform 0.2s ease-out;
            }
        }
        .service:hover{
            sound-in:ui.button.over;
            background-color: white;
            border-color: rgb(0, 215, 187);
            transform: scale(1.05) translateY(-2%);
            box-shadow: 0px 0px 40px rgba(0, 215, 187, 0.5);
            .logo-img {
                transform: scale(0.82);
            }
        }
        .service:active{
            sound-in: ui.button.press;
        }

        .not_loaded{
            color: rgba(0, 0, 0, 0);
            
            align-items: center;
            position: relative;
            height: 1%;
            width: 1%;
            font-weight: bold;
            font-size: 10vw;
            transform: scale(0);
           
            transition: all 0.25s ease-in-out;
            opacity: 0;
        }
        &.Notinside{
            .container{
                display: none;
            }
            .logo{
                display: none;
            }
            .info{
               display: none;
            }
            .not_loaded{
			    transform: scale(1);
                color: rgb(255, 116, 116);
                opacity: 1;
                width: 100%;
                height: 100%;
            }
            .ptext{
			    display: none;
            }
            .title{
			   display: none;
            }
        }
        
    }
    
</style>

<root class="ScreeenUI">
        <text class="not_loaded">#mediaplayer.enterLocation</text>
	    <div class="logo">
           <text style="color:rgb(0, 215, 187);">Media|</text><text>Player</text>
        </div>
        <text class="info">#mediaplayer.selectType</text>
        <div class="container">
           <button @onclick=@(()=>OpenRequest($"https://www.youtube.com/")) class="service"><div class="logo-img" style="background-image:url(/ui/services/youtube.png);"></div></button>
           <button @onclick=@(()=>OpenRequest($"https://soundcloud.com/")) class="service"><div class="logo-img" style="background-image:url(/ui/services/soundcloud.png);"></div></button>
           <button @onclick=@(()=>OpenRequest($"https://www.twitch.tv/")) class="service"><div class="logo-img" style="background-image:url(/ui/services/twitch.png);"></div></button>
           <button @onclick=@(()=>OpenRequest($"direct")) class="service"><div class="logo-img" style="background-image:url(/ui/services/directlink.png);"></div></button>
        </div>
        
        <text class="info">#mediaplayer.bindsInfo</text>
</root>

@code {
    public MediaPlayer MediaPlayer { get; set; }
   
    private void OpenRequest(string url){
        RequestMenu.Open(MediaPlayer,url);
    }

    protected override int BuildHash()
    {

        return HashCode.Combine(MediaPlayer.GetHashCode());
    }
}
