@using Sandbox.UI
@using System
@using System.Linq
@using System.Threading.Tasks

@inherits PanelComponent
<style>
    @@keyframes taunt-window-in {
        0% { opacity: 0; transform: scale(0.94); }
        100% { opacity: 1; transform: scale(1); }
    }
    @@keyframes taunt-tile-in {
        0% { opacity: 0; transform: translateY(12px); }
        100% { opacity: 1; transform: translateY(0px); }
    }

    TauntMenu {
        position: absolute;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        justify-content: center;
        align-items: center;
        background-color: #00000077;
        backdrop-filter: blur(6px);
        pointer-events: all;
        font-family: Poppins;
        color: #e8e8e8;
        transition: opacity 0.15s ease;

        &.closing { opacity: 0; pointer-events: none; }
    }

    .tm-window {
        width: 900px;
        max-height: 88%;
        flex-direction: column;
        border-radius: 16px;
        border: 1px solid #ffffff14;
        background-color: #0d0e10f5;
        box-shadow: 0px 16px 60px #000000cc;
        overflow: hidden;
        animation: taunt-window-in 0.2s ease-out;
    }

    .tm-header {
        flex-shrink: 0;
        flex-direction: row;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        font-family: BerlinSansFBDemi;
        font-size: 26px;
        letter-spacing: 2px;
        color: #00d7bb;
        background-color: #00d7bb14;
        border-bottom: 1px solid #ffffff0f;
        i { font-size: 30px; }
        .tm-stop {
            margin-left: auto;
            flex-direction: row;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 8px;
            font-family: Poppins;
            font-size: 15px;
            letter-spacing: 0px;
            color: #ff8a8a;
            background-color: #ff6b6b1a;
            i { font-size: 18px; }
            &:hover { background-color: #ff6b6b40; cursor: pointer; }
        }
        .tm-close {
            width: 40px;
            height: 40px;
            justify-content: center;
            align-items: center;
            border-radius: 8px;
            font-size: 26px;
            color: #cfcfcf;
            &:hover { background-color: #ff4d5e33; color: #ff6b6b; cursor: pointer; }
        }
        .spacer { flex-grow: 1; }
    }

    .tm-body {
        flex-direction: column;
        gap: 16px;
        padding: 18px 20px 22px 20px;
        overflow: scroll;
    }

    .tm-section {
        flex-shrink: 0;
        flex-direction: column;
        gap: 10px;
    }

    .tm-label {
        font-size: 14px;
        letter-spacing: 1px;
        color: #ffffff66;
    }

    .tm-grid {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 10px;
    }

    .tm-tile {
        flex-shrink: 0;
        width: 196px;
        height: 104px;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 6px;
        border-radius: 12px;
        border: 1px solid #ffffff12;
        background-color: #ffffff08;
        animation: taunt-tile-in 0.25s ease-out;
        transition: all 0.12s ease;
        i { font-size: 38px; color: #00d7bb; transition: transform 0.15s ease; }
        .name { font-family: BerlinSansFBDemi; font-size: 17px; color: white; }
        .loop {
            position: absolute;
            right: 8px;
            top: 8px;
            font-size: 16px;
            color: #ffffff55;
        }
        &:hover {
            background-color: #00d7bb1f;
            border-color: #00d7bb66;
            cursor: pointer;
            sound-in: ui.button.over;
            i { transform: scale(1.15); }
        }
        &:active { sound-in: ui.button.press; }
        &.playing { border-color: #00d7bb; background-color: #00d7bb26; }
    }

    .tm-hint {
        flex-shrink: 0;
        flex-direction: row;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        font-size: 14px;
        color: #ffffff80;
        background-color: #ffffff06;
        border-top: 1px solid #ffffff0f;
        i { font-size: 18px; }
    }
</style>
<root class="@(Closing ? "closing" : "")">
    <div class="tm-window">
        <div class="tm-header">
            <i>emoji_people</i>
            <label>TAUNTS</label>
            <div class="spacer"></div>
            @if (Player?.IsTaunting == true)
            {
                <button class="tm-stop" @onclick=@Stop><i>stop</i><label>Stop</label></button>
            }
            <button class="tm-close" @onclick=@Close><i>close</i></button>
        </div>

        <div class="tm-body">
            @foreach (var category in Taunts.Categories)
            {
                <div class="tm-section">
                    <label class="tm-label">@category.ToUpperInvariant()</label>
                    <div class="tm-grid">
                        @foreach (var taunt in Taunts.All.Where(x => x.Category == category))
                        {
                            <div class="tm-tile @(Player?.Taunt == taunt.Id ? "playing" : "")" @onclick=@(() => Play(taunt))>
                                <i>@taunt.Icon</i>
                                <label class="name">@taunt.Title</label>
                                @if (taunt.Loop)
                                {
                                    <i class="loop">repeat</i>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="tm-hint">
            <i>3d_rotation</i>
            <label>Move the mouse to look around while you taunt. Moving or jumping stops it.</label>
        </div>
    </div>
</root>
@code{
    private TheaterPlayer Player=>Game.ActiveScene?.GetAllComponents<TheaterPlayer>().FirstOrDefault(x=>!x.IsProxy);
    private bool Closing {get;set;}

    public static TauntMenu Open()
    {
        var panel=Game.ActiveScene.GetAllComponents<ScreenPanel>().FirstOrDefault();
        if (panel==null) return null;
        return panel.Components.Get<TauntMenu>()??panel.Components.Create<TauntMenu>();
    }

    protected override void OnStart()
    {
        Flags=ComponentFlags.NotNetworked;
        base.OnStart();
    }

    protected override void OnUpdate()
    {
        base.OnUpdate();
        if (Input.EscapePressed){
            Input.EscapePressed=false;
            Close();
        }
    }

    private void Play(TauntDef taunt)
    {
        Player?.StartTaunt(taunt.Id);
        Close();
    }

    private void Stop()
    {
        Player?.StopTaunt();
        StateHasChanged();
    }

    public async void Close()
    {
        if (Closing) return;
        Closing=true;
        StateHasChanged();
        await Task.DelayRealtimeSeconds(0.15f);
        if (this.IsValid()) Destroy();
    }

    /// <summary>While open, Escape closes this menu instead of opening the game menu.</summary>
    public static bool IsOpen {get;private set;}
    protected override void OnEnabled()
    {
        base.OnEnabled();
        IsOpen=true;
    }
    protected override void OnDestroy()
    {
        IsOpen=false;
        Panel?.Delete();
        base.OnDestroy();
    }

    protected override int BuildHash()
    {
        return HashCode.Combine(Closing,Player?.Taunt);
    }
}
